# ─────────────────────────────────────────────
# BASE DE DATOS - MySQL
# Formato: mysql://usuario:password@host:puerto/nombre_base_de_datos
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/sneark_db"
# ─────────────────────────────────────────────

# SERVIDOR
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
BACKEND_URL=http://localhost:3000

# MERCADO PAGO (opcional para arrancar la API; requerido para crear pagos)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ENVÍO LOCAL (distritos permitidos definidos en backend)
DELIVERY_FREE_DISTRICT=La Esperanza
DELIVERY_FLAT_RATE_PEN=15

# JWT
JWT_SECRET=
# Duración del token: entero positivo seguido de s, m, h, d, w o y (por ejemplo, 7d)
JWT_EXPIRES_IN=7d

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Administrador inicial (rellenar solo durante la inicialización)
ADMIN_EMAIL=
ADMIN_PASSWORD=
