# ─────────────────────────────────────────────
# BASE DE DATOS - MySQL
# Formato: mysql://usuario:password@host:puerto/nombre_base_de_datos
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/sneark_db"
# ─────────────────────────────────────────────

# SERVIDOR
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
BACKEND_URL=http://localhost:3000

# JWT
JWT_SECRET=
# Duración del token: entero positivo seguido de s, m, h, d, w o y (por ejemplo, 7d)
JWT_EXPIRES_IN=7d

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MERCADO PAGO
# MP_ACCESS_TOKEN: obtenerlo desde https://www.mercadopago.com.pe/developers/panel
# MP_WEBHOOK_SECRET: obtenerlo desde la configuración del webhook en el panel de MP
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Administrador inicial (rellenar solo durante la inicialización)
ADMIN_EMAIL=
ADMIN_PASSWORD=
